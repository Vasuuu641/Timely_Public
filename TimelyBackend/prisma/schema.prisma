generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  username         String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  fullname         String?
  refreshToken     String?           @db.Text
  DailyReview      DailyReview[]
  featureUsage     FeatureUsage[]
  notes            Note[]
  pomodoroSessions PomodoroSession[]
  quizzes          Quiz[]
  schedules        ScheduleEntry[]
  studyGoals       StudyGoal[]
  todos            Todo[]            @relation("UserTodos")
}

model ScheduleEntry {
  id          String    @id @default(uuid())
  title       String
  startTime   DateTime
  endTime     DateTime?
  topic       String?   @default("General")
  priority    String?   @default("Medium")
  status      String?   @default("ToDo")
  isDailyPlan Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  isRecurring Boolean   @default(false)
  notes       String?
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([topic])
}

model Todo {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  isCompleted Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String
  dueDate     DateTime?
  priority    TodoPriority @default(MEDIUM)
  user        User         @relation("UserTodos", fields: [userId], references: [id])

  @@index([userId], map: "Todo_userId_fkey")
}

model DailyReview {
  id         Int      @id @default(autoincrement())
  date       DateTime
  reflection String   @db.Text
  rating     Int?
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@unique([date, userId])
  @@index([userId], map: "DailyReview_userId_fkey")
}

model PomodoroSession {
  id                Int               @id @default(autoincrement())
  userId            String
  level             PomodoroLevel
  focusStart        DateTime
  focusEnd          DateTime?
  pointsEarned      Int               @default(0)
  isCompleted       Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  totalBreakMinutes Int?              @default(0)
  breaks            Break[]
  user              User              @relation(fields: [userId], references: [id])
  postSessionBreak  PostSessionBreak?

  @@index([userId], map: "PomodoroSession_userId_fkey")
}

model Break {
  id        Int             @id @default(autoincrement())
  sessionId Int
  startTime DateTime
  endTime   DateTime?
  createdAt DateTime        @default(now())
  session   PomodoroSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId], map: "Break_sessionId_fkey")
}

model PostSessionBreak {
  id        Int             @id @default(autoincrement())
  sessionId Int             @unique
  startTime DateTime
  endTime   DateTime?
  session   PomodoroSession @relation(fields: [sessionId], references: [id])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  notes Note[]
}

model Note {
  id         String    @id @default(uuid())
  title      String
  content    String    @db.LongText
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
  tags       NoteTag[]

  @@index([userId])
  @@index([userId, categoryId])
  @@index([categoryId], map: "Note_categoryId_fkey")
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  notes NoteTag[]
}

model NoteTag {
  noteId String
  tagId  String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId], map: "NoteTag_tagId_fkey")
}

model Quiz {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String?
  correctAnswer String
  options       String   @db.Text
  topic         String
  question      String   @db.Text
  title         String
  user          User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([title])
}

model StudyGoal {
  id        String   @id @default(cuid())
  userId    String
  type      GoalType
  target    Int
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "StudyGoal_userId_fkey")
}

model FeatureUsage {
  id         String   @id @default(uuid())
  userId     String
  feature    String
  usageCount Int      @default(0)
  lastUsed   DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, feature])
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
}

enum PomodoroLevel {
  EASY
  MEDIUM
  HARD
}

enum GoalType {
  NOTE
  TASK
  POMODORO
  STUDY_HOURS
}
